AI_PROVIDER = "groq"
GROQ_API_KEY = "paste-your-private-groq-api-key-here"
GROQ_MODEL = "openai/gpt-oss-20b"
# Optional legacy provider; only used when AI_PROVIDER = "openai".
# OPENAI_API_KEY = "paste-your-private-api-key-here"
# OPENAI_MODEL = "gpt-5.6-luna"
# Set this in your private .streamlit/secrets.toml file to enable owner sign-in.
# OWNER_DASHBOARD_PASSWORD = "replace-with-a-long-random-password"

# Optional email follow-ups: configure privately using your email provider's
# SMTP instructions. A provider-approved SMTP/app password may be required.
# FOLLOWUP_SMTP_HOST = "your-provider-smtp-host"
# FOLLOWUP_SMTP_PORT = "587"
# FOLLOWUP_SMTP_USERNAME = "your-sender-email"
# FOLLOWUP_SMTP_PASSWORD = "your-private-smtp-credential"
# FOLLOWUP_SMTP_FROM = "your-sender-email"
# FOLLOWUP_PUBLIC_URL = "https://your-shared-mira-website"
# Validate without sending: python run_followup_worker.py --check
# Sending requires an OS scheduler running run_followup_worker.py.
